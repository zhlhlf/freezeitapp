<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 夜间资源同样为浅色（本 app 日/夜两模统一为谷歌风浅色，禁止被翻回深色） -->
    <style name="Theme.freezeit" parent="Theme.MaterialComponents.Light.Bridge">
        <item name="colorPrimary">@color/g_primary</item>
        <item name="colorPrimaryVariant">@color/g_primary_variant</item>
        <item name="colorOnPrimary">@color/g_on_primary</item>
        <item name="colorSecondary">@color/g_primary</item>
        <item name="colorSecondaryVariant">@color/g_primary_variant</item>
        <item name="colorOnSecondary">@color/g_on_primary</item>

        <item name="colorSurface">@color/g_surface</item>
        <item name="colorOnSurface">@color/g_on_surface</item>
        <item name="colorError">@color/g_error</item>
        <item name="android:textColorPrimary">@color/g_on_surface</item>
        <item name="android:textColorSecondary">@color/g_on_surface_variant</item>
        <item name="android:textColorPrimaryInverse">@color/g_on_primary</item>

        <item name="android:colorBackground">@color/g_background</item>
        <item name="android:windowBackground">@color/g_background</item>
        <item name="android:statusBarColor">@color/g_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/g_background</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>

        <item name="actionBarStyle">@style/Widget.App.ActionBar</item>
        <item name="actionBarTheme">@style/ThemeOverlay.App.ActionBar</item>
        <item name="actionBarPopupTheme">@style/ThemeOverlay.MaterialComponents.Light</item>

        <item name="android:alertDialogTheme">@style/Theme.App.Dialog</item>
        <item name="alertDialogTheme">@style/Theme.App.Dialog</item>
        <item name="dialogCornerRadius">@dimen/dialog_radius</item>
    </style>

    <style name="Widget.App.ActionBar" parent="Widget.MaterialComponents.ActionBar.Surface">
        <item name="android:background">@color/g_surface</item>
        <item name="android:elevation">0dp</item>
        <item name="android:titleTextStyle">@style/TextAppearance.App.ActionBar.Title</item>
    </style>

    <style name="TextAppearance.App.ActionBar.Title" parent="TextAppearance.MaterialComponents.Headline6">
        <item name="android:textColor">@color/g_on_surface</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="ThemeOverlay.App.ActionBar" parent="ThemeOverlay.MaterialComponents.ActionBar.Surface">
        <item name="android:textColorPrimary">@color/g_on_surface</item>
        <item name="android:textColorSecondary">@color/g_on_surface_variant</item>
        <item name="colorControlNormal">@color/g_on_surface_variant</item>
        <item name="actionMenuTextColor">@color/g_on_surface</item>
        <item name="android:colorBackground">@color/g_surface</item>
    </style>

    <style name="Theme.App.Dialog" parent="Theme.MaterialComponents.Light.Dialog.Alert.Bridge">
        <item name="colorPrimary">@color/g_primary</item>
        <item name="colorPrimaryVariant">@color/g_primary_variant</item>
        <item name="colorOnPrimary">@color/g_on_primary</item>
        <item name="colorSecondary">@color/g_primary</item>
        <item name="colorSurface">@color/g_surface</item>
        <item name="colorOnSurface">@color/g_on_surface</item>
        <item name="android:textColorPrimary">@color/g_on_surface</item>
        <item name="android:textColorSecondary">@color/g_on_surface_variant</item>
        <item name="dialogCornerRadius">@dimen/dialog_radius</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="footButton" parent="ThemeOverlay.MaterialComponents.Light">
        <item name="colorPrimary">@color/g_primary</item>
        <item name="colorSecondary">@color/g_primary</item>
        <item name="colorOnSurface">@color/g_on_surface</item>
        <item name="android:textColorPrimary">@color/g_on_surface</item>
    </style>
</resources>
