<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/container"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/g_background"
    android:clipToPadding="false"
    android:scrollbars="none"
    tools:context=".activity.Settings">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/width_margin"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="@dimen/screen_padding_bottom">

        <!-- ========== 冻结策略 ========== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/glass_card"
            android:clipToOutline="true"
            android:elevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/App.CardHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/freeze_mode_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/freeze_mode_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/freeze_mode_title" />

                    <Spinner
                        android:id="@+id/freeze_mode_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/work_mode"
                        android:spinnerMode="dropdown" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/refreeze_timeout_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/refreeze_timeout_title" />

                    <Spinner
                        android:id="@+id/refreeze_timeout_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/refreeze_timeout"
                        android:spinnerMode="dropdown" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/wakeup_timeout_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/wakeup_timeout_title" />

                    <Spinner
                        android:id="@+id/wakeup_timeout_spinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:entries="@array/wakeup_timeout"
                        android:spinnerMode="dropdown" />

                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ========== 超时参数（滑块） ========== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:background="@drawable/glass_card"
            android:clipToOutline="true"
            android:elevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <TextView
                    style="@style/App.CardHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/freeze_timeout_title" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/freeze_timeout_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/freeze_timeout_title" />

                    <TextView
                        android:id="@+id/freeze_timeout_value_text"
                        style="@style/App.ValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/number" />

                    <TextView
                        style="@style/App.RowCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:text="@string/second" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarTimeout"
                    style="@style/Widget.AppCompat.SeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="60"
                    android:maxHeight="28dp"
                    android:min="1"
                    android:minHeight="28dp"
                    android:paddingBottom="12dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:progressTint="@color/g_primary"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="0dp"
                    android:thumbTint="@color/g_primary" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="@color/g_outline" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/terminate_timeout_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/terminate_timeout_title" />

                    <TextView
                        android:id="@+id/terminate_timeout_value_text"
                        style="@style/App.ValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/number" />

                    <TextView
                        style="@style/App.RowCaption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="6dp"
                        android:text="@string/second" />
                </LinearLayout>

                <SeekBar
                    android:id="@+id/seekBarTerminate"
                    style="@style/Widget.AppCompat.SeekBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="120"
                    android:maxHeight="28dp"
                    android:min="3"
                    android:minHeight="28dp"
                    android:progressDrawable="@drawable/seekbar_bg"
                    android:progressTint="@color/g_primary"
                    android:thumb="@drawable/thumb"
                    android:thumbOffset="0dp"
                    android:thumbTint="@color/g_primary" />
            </LinearLayout>
        </FrameLayout>

        <!-- ========== 开关项 ========== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:background="@drawable/glass_card"
            android:clipToOutline="true"
            android:elevation="@dimen/card_elevation">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/card_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/battery_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/battery_title" />

                    <Switch
                        android:id="@+id/switch_battery"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/selector"
                        android:minHeight="30dp"
                        android:thumbTint="@color/white"
                        android:trackTint="@color/transparent"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/current_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/current_title" />

                    <Switch
                        android:id="@+id/switch_current"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/selector"
                        android:minHeight="30dp"
                        android:thumbTint="@color/white"
                        android:trackTint="@color/transparent"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/double_cell_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/double_cell_title" />

                    <Switch
                        android:id="@+id/switch_double_cell"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/selector"
                        android:minHeight="30dp"
                        android:thumbTint="@color/white"
                        android:trackTint="@color/transparent"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lmk_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/lmk_title" />

                    <Switch
                        android:id="@+id/switch_lmk"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/selector"
                        android:minHeight="30dp"
                        android:thumbTint="@color/white"
                        android:trackTint="@color/transparent"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/doze_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/doze_title" />

                    <Switch
                        android:id="@+id/switch_doze"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/selector"
                        android:minHeight="30dp"
                        android:thumbTint="@color/white"
                        android:trackTint="@color/transparent"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/debug_title"
                        style="@style/App.RowTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/debug_title" />

                    <Switch
                        android:id="@+id/switch_debug"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/selector"
                        android:minHeight="30dp"
                        android:thumbTint="@color/white"
                        android:trackTint="@color/transparent"
                        tools:ignore="UseSwitchCompatOrMaterialXml" />
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <!-- ========== 背景 ========== -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/card_spacing"
            android:background="@drawable/glass_card"
            android:clipToOutline="true"
            android:elevation="@dimen/card_elevation">

            <TextView
                android:id="@+id/set_bg"
                style="@style/App.RowTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawablePadding="10dp"
                android:padding="@dimen/card_padding"
                android:text="@string/set_background" />
        </FrameLayout>

    </LinearLayout>

</ScrollView>
