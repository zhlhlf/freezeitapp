<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/g_background"
    tools:context=".fragment.Logcat">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:paddingHorizontal="@dimen/width_margin"
        android:paddingTop="@dimen/screen_padding_top"
        android:paddingBottom="112dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 日志面板（毛玻璃卡片） -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/glass_card"
                android:clipToOutline="true"
                android:elevation="@dimen/card_elevation">

                <TextView
                    android:id="@+id/logView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:padding="@dimen/card_padding"
                    android:scrollbars="vertical"
                    android:textColor="@color/g_on_surface"
                    android:textSize="12sp"
                    android:typeface="monospace" />
            </FrameLayout>

            <View
                android:id="@+id/forBottom"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:contentDescription="@string/number"
                android:focusable="true"
                android:focusableInTouchMode="true" />
        </LinearLayout>
    </ScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="12dp"
        android:contentDescription="@string/icon"
        app:backgroundTint="@color/g_primary"
        app:elevation="6dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toTopOf="@+id/fabClear"
        app:layout_constraintRight_toRightOf="parent"
        app:rippleColor="@color/g_ripple"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Fab"
        app:srcCompat="@drawable/ic_freezeit_24dp"
        app:tint="@color/g_on_primary" />

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabClear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/fab_margin"
        android:layout_marginBottom="@dimen/fab_margin"
        android:contentDescription="@string/icon"
        app:backgroundTint="@color/g_surface"
        app:elevation="6dp"
        app:fabSize="normal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:rippleColor="@color/g_ripple"
        app:shapeAppearanceOverlay="@style/ShapeAppearanceOverlay.App.Fab"
        app:srcCompat="@drawable/ic_clear_log_24dp"
        app:tint="@color/g_primary" />

</androidx.constraintlayout.widget.ConstraintLayout>
