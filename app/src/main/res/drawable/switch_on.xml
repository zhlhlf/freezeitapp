<?xml version="1.0" encoding="utf-8"?>
<!-- 开关（选中）：谷歌蓝胶囊 + 顶部高光 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <gradient
                android:angle="270"
                android:endColor="@color/g_primary_variant"
                android:startColor="@color/g_primary"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
