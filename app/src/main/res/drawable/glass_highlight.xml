<?xml version="1.0" encoding="utf-8"?>
<!-- 仅顶部高光（铺在 MaterialCardView 的内容层上，营造玻璃光泽） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius" />
            <gradient
                android:angle="270"
                android:endColor="@color/glass_highlight_end"
                android:startColor="@color/glass_highlight"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
