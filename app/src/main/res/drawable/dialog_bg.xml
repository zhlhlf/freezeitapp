<?xml version="1.0" encoding="utf-8"?>
<!--
  对话框面板：大圆角 + 半透明白底 + 1dp 浅亮边（毛玻璃观感）。
  半透明是为了让 minSdk 31 的窗口背景模糊（若可用）透出来；
  即使没有真模糊，浅色面板本身也成立。
-->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dialog_radius" />
            <gradient
                android:angle="270"
                android:endColor="#D9FFFFFF"
                android:startColor="#F2FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/dialog_radius" />
            <stroke
                android:width="1dp"
                android:color="@color/glass_stroke" />
        </shape>
    </item>
</layer-list>
