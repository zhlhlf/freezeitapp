<?xml version="1.0" encoding="utf-8"?>
<!-- 应用列表行：浅色圆角卡（毛玻璃观感） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius_sm" />
            <gradient
                android:angle="270"
                android:endColor="#B3FFFFFF"
                android:startColor="#E6FFFFFF"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/card_radius_sm" />
            <stroke
                android:width="1dp"
                android:color="@color/g_outline" />
        </shape>
    </item>
</layer-list>
